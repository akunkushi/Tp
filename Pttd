env.__TDMacroCleanup = function()
    alive = false
    voteGen = voteGen + 1
    recording, playing = false, false
    playToken = playToken + 1
    if Shared then Shared.recording = false Shared.cb = nil Shared.map = {} end
    for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
    pcall(function() gui:Destroy() end)
end

