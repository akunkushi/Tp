local function parseNum(s)
    if type(s) == "number" then return s end
    s = tostring(s):gsub(",", "")
    local n = s:match("%-?%d+%.?%d*")
    return n and tonumber(n) or nil
end
local function hasName(name, pats, exact)
    local n = string.lower(name)
    for _, p in ipairs(pats) do
        if exact then
            if n == p then return true end
        elseif string.find(n, p, 1, true) then
            return true
        end
    end
    return false
end
local function readAny(v)
    if typeof(v) == "Instance" then
        local ok, val = pcall(function() return v.Value end)
        if not ok then return nil end
        v = val
    end
    if type(v) == "number" then return v end
    if type(v) == "string" then return parseNum(v) end
    return nil
end

local function isVisible(d)
    local cur = d
    while cur and cur ~= game do
        if cur:IsA("GuiObject") and not cur.Visible then return false end
        if cur:IsA("ScreenGui") and not cur.Enabled then return false end
        cur = cur.Parent
    end
    return true
end

local function stripTags(s) return (tostring(s):gsub("<[^>]+>", "")) end

local function inBlockedUI(d)
    local cur = d
    while cur and cur ~= game do
        local n = string.lower(cur.Name)
        if string.find(n, "difficulty", 1, true) or string.find(n, "vote", 1, true) then
            return true
        end
        cur = cur.Parent
    end
    return false
end

local function waveFromText(text, strict)
    local s = string.lower(stripTags(text))
    local n = s:match("wave%s*(%d+)%s*/%s*%d+")
    if n then return tonumber(n) end
    if not strict then
        n = s:match("^%s*wave%s*:?%s*(%d+)%s*$")
        if n then return tonumber(n) end
    end
    return nil
end

local function argsToStr(t)
    local parts = {}
    local n = t.n or #t
    for i = 1, n do parts[#parts + 1] = tostring(t[i]) end
    return table.concat(parts, ", ")
end

