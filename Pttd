local Shared = env.__TDMacroShared2
if not Shared then
    Shared = { recording = false, map = {} }
    env.__TDMacroShared2 = Shared

    if hookmetamethod and getnamecallmethod and newcclosure and checkcaller then
        local old
        old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if Shared.recording and (method == "InvokeServer" or method == "FireServer") then
                local kind = Shared.map[self]
                if kind and not checkcaller() then
                    local args = { ... }
                    local st = Shared.state
                    local wave, t = st.wave, st.waveTime
                    local res = table.pack(old(self, ...))
                    local cb = Shared.cb
                    if cb then task.spawn(cb, kind, args, res, wave, t) end
                    return table.unpack(res, 1, res.n)
                end
            end
            return old(self, ...)
        end))
    else
        task.defer(function()
            log("Executor tidak support hookmetamethod, Record tidak bisa.", COL.bad)
        end)
    end
end

local function onRemoteInvoked(kind, args, res, wave, t)
    if not recording then return end
    local first = res[1]

    if kind == "place" then
        local name, pos, rot = args[1], args[2], args[3]
        if type(name) ~= "string" or typeof(pos) ~= "Vector3" then return end
        if not isSuccess(first, "place") then
            log(string.format("GAGAL place %s (tidak direkam) | result: %s", name, tostring(first)), COL.bad)
            return
        end
        if type(rot) ~= "number" and type(rot) ~= "string" then rot = 0 end
        towerCount = towerCount + 1
        local id = towerCount
        table.insert(steps, {
            type = "place", id = id, name = name,
            x = pos.X, y = pos.Y, z = pos.Z, rot = rot,
            wave = wave, t = t,
        })
        active[id] = { name = name, pos = pos }
        bindTower(id, name, pos)
        log(string.format("RECORD #%d place %s @ (%.1f, %.1f, %.1f) | wave %s t=%.1fs | result: %s",
            id, name, pos.X, pos.Y, pos.Z, tostring(wave), t, tostring(first)), COL.ok)

    elseif kind == "upgrade" then
        local id = idFromInstance(args[1])
        if not isSuccess(first, "upgrade") then
            log("GAGAL upgrade (tidak direkam) | result: " .. tostring(first), COL.bad)
            return
        end
        if not id then
            log("Upgrade tower yang tidak dikenal (bukan dari record ini), dilewati.", COL.warn)
            return
        end
        upgCount[id] = (upgCount[id] or 0) + 1
        table.insert(steps, { type = "upgrade", id = id, wave = wave, t = t })
        log(string.format("RECORD upgrade #%d (ke-%d) | wave %s t=%.1fs | result: %s",
            id, upgCount[id], tostring(wave), t, tostring(first)), COL.ok)

    elseif kind == "sell" then
        local id = idFromInstance(args[1])
        if not isSuccess(first, "sell") then
            log("GAGAL sell (tidak direkam) | result: " .. tostring(first), COL.bad)
            return
        end
        if not id then
            log("Sell tower yang tidak dikenal (bukan dari record ini), dilewati.", COL.warn)
            return
        end
        table.insert(steps, { type = "sell", id = id, wave = wave, t = t })
        active[id] = nil
        log(string.format("RECORD sell #%d | wave %s t=%.1fs | result: %s",
            id, tostring(wave), t, tostring(first)), COL.ok)

    elseif kind == "target" then
        local id = idFromInstance(args[1])
        local mode = args[2]
        if not id or type(mode) ~= "string" then
            log("Target tower tidak dikenal, dilewati.", COL.warn)
            return
        end
        table.insert(steps, { type = "target", id = id, mode = mode, wave = wave, t = t })
        log(string.format("RECORD target #%d -> %s | wave %s t=%.1fs", id, mode, tostring(wave), t), COL.ok)
    end
end

