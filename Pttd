-- Auto speed
task.spawn(function()
    local lastFire = 0
    while alive do
        local target = settings.autoSpeed
        if type(target) == "number" and target > 0 then
            local need
            if state.speedDetected then
                need = math.abs(state.speedDetected - target) > 0.01
            else
                need = (tick() - lastFire) > 5
            end
            if need and tick() - lastFire > 1.5 then
                local ev = ReplicatedStorage:FindFirstChild(CONFIG.SpeedRemote)
                if ev then
                    pcall(function() ev:FireServer(target) end)
                    lastFire = tick()
                    firedSpeed = target
                end
            end
        end
        task.wait(1)
    end
end)

-- Auto replay (hanya saat match selesai)
local END_WORDS = {"victory", "defeat", "game over", "you win", "you won", "you lose", "you lost",
                   "match complete", "match over", "mission complete", "mission failed"}
local AGAIN_WORDS = {"again", "play again", "replay"}

local function detectMatchEnded()
    if CONFIG.IsMatchEnded then
        local ok, v = pcall(CONFIG.IsMatchEnded)
        return ok and v and true or false, "custom"
    end
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return false end
    for _, d in ipairs(pg:GetDescendants()) do
        if (d:IsA("TextLabel") or d:IsA("TextButton")) and not d:IsDescendantOf(gui) then
            local txt = d.Text
            if type(txt) == "string" and txt ~= "" and guiVisible(d) then
                local l = string.lower(txt)
                for _, w in ipairs(END_WORDS) do
                    if string.find(l, w, 1, true) then return true, d:GetFullName() end
                end
                if d:IsA("TextButton") then
                    local trimmed = l:gsub("^%s+", ""):gsub("%s+$", "")
                    for _, w in ipairs(AGAIN_WORDS) do
                        if trimmed == w then return true, d:GetFullName() end
                    end
                end
            end
        end
    end
    return false
end

task.spawn(function()
    local hits, lastFire = 0, 0
    while alive do
        task.wait(1.5)
        if settings.autoReplay then
            local ok, ended, who = pcall(detectMatchEnded)
            if ok and ended then
                hits = hits + 1
                if hits >= 2 and tick() - lastFire > 10 then
                    lastFire = tick()
                    local ev = getRemote(CONFIG.MatchRemote)
                    if ev then
                        pcall(function() ev:FireServer("Again") end)
                        log("Match selesai (" .. tostring(who) .. ") -> Replay", COL.ok)
                    else
                        log("Remote MatchAction tidak ketemu.", COL.bad)
                    end
                end
            else
                hits = 0
            end
        else
            hits = 0
        end
    end
end)

-- Auto vote difficulty (jeda 3s sebelum mulai, retry 5x setiap 1s)
local voteBusy = false
local voteGen = 0

voteBurst = function()
    if voteBusy then return end
    voteBusy = true
    task.spawn(function()
        local maxTries = CONFIG.VoteMaxTries or 5
        local retryDelay = CONFIG.VoteRetryDelay or 1
        for attempt = 1, maxTries do
            if not alive or not settings.autoVote then break end
            if attempt > 1 and not isVoting() then
                log("Panel vote sudah tertutup, vote selesai.", COL.ok)
                break
            end
            local ev = getRemote(CONFIG.VoteRemote)
            if ev then
                local d = settings.difficulty
                pcall(function() ev:FireServer(d) end)
                log(string.format("Vote difficulty (%d/%d): %s", attempt, maxTries, tostring(d)), COL.ok)
            else
                log(string.format("Remote Vote tidak ketemu (%d/%d), mencoba lagi...", attempt, maxTries), COL.warn)
            end
            if attempt < maxTries then
                task.wait(retryDelay)
            end
        end
        voteBusy = false
    end)
end

scheduleVote = function(delay)
    local dly = delay or CONFIG.VoteDelay
    voteGen = voteGen + 1
    local gen = voteGen
    if dly > 0 then
        log(string.format("Auto vote difficulty dijadwalkan dalam %ds...", dly), COL.warn)
    end
    task.delay(dly, function()
        if not alive or gen ~= voteGen or not settings.autoVote then return end
        voteBurst()
    end)
end

task.spawn(function()
    local last = 0
    local cooldown = CONFIG.VoteDelay + (CONFIG.VoteMaxTries * CONFIG.VoteRetryDelay) + 1
    while alive do
        task.wait(1)
        -- selama panel pilih difficulty tampil, beri jeda sebelum vote
        if settings.autoVote and isVoting() and tick() - last > cooldown then
            last = tick()
            scheduleVote(CONFIG.VoteDelay)
        end
    end
end)

