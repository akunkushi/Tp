local function sanitize(n)
    n = tostring(n or ""):gsub("[^%w_%-]", "_")
    return n:sub(1, 24)
end
local function ensureDir()
    if isfolder and makefolder and not isfolder(CONFIG.MacroDir) then pcall(makefolder, CONFIG.MacroDir) end
end
local function macroPath(n) return CONFIG.MacroDir .. "/" .. n .. ".json" end

local function saveSettings()
    if writefile then
        pcall(function() writefile(CONFIG.SettingsFile, HttpService:JSONEncode(settings)) end)
    end
end
local function loadSettings()
    if isfile and readfile and isfile(CONFIG.SettingsFile) then
        local ok, d = pcall(function() return HttpService:JSONDecode(readfile(CONFIG.SettingsFile)) end)
        if ok and type(d) == "table" then
            for k, v in pairs(d) do settings[k] = v end
        end
    end
    if type(settings.deleted) ~= "table" then settings.deleted = {} end
end

local function writeMacro(name)
    if not (writefile and makefolder) then return false end
    ensureDir()
    local ok = pcall(function()
        writefile(macroPath(name), HttpService:JSONEncode({ version = 2, steps = steps }))
    end)
    if ok and settings.deleted[name] then
        settings.deleted[name] = nil
        saveSettings()
    end
    return ok
end
local function readMacro(name)
    if settings.deleted[name] then return nil end
    if not (readfile and isfile) then return nil end
    local p = macroPath(name)
    if not isfile(p) then return nil end
    local ok, d = pcall(function() return HttpService:JSONDecode(readfile(p)) end)
    if not ok or type(d) ~= "table" then return nil end
    return d.steps or d
end
local function listMacros()
    local out = {}
    if listfiles and isfolder and isfolder(CONFIG.MacroDir) then
        local ok, files = pcall(listfiles, CONFIG.MacroDir)
        if ok and type(files) == "table" then
            for _, f in ipairs(files) do
                local n = tostring(f):match("([^/\\]+)%.json$")
                if n and not settings.deleted[n] then table.insert(out, n) end
            end
        end
    end
    table.sort(out)
    return out
end

