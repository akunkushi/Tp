-- Diagnosis tambahan (v2.6): yang berubah saat fase akhir match
local function watchExtra()
    local n = 0
    for _, d in ipairs(game:GetDescendants()) do
        if n >= 100 then break end
        if d:IsA("RemoteEvent") and not d:IsDescendantOf(ReplicatedStorage) then
            n = n + 1
            track(d.OnClientEvent:Connect(function(...)
                if matchOver then
                    log("Event non-RS: " .. d:GetFullName() .. " (" .. evSummary(...) .. ")", COL.bad)
                end
            end))
        end
    end
    track(LocalPlayer.AttributeChanged:Connect(function(a)
        if matchOver then
            log("Attr pemain: " .. a .. " = " .. tostring(LocalPlayer:GetAttribute(a)), COL.bad)
        end
    end))
    track(workspace.AttributeChanged:Connect(function(a)
        if matchOver then
            log("Attr workspace: " .. a .. " = " .. tostring(workspace:GetAttribute(a)), COL.warn)
        end
    end))
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if pg then
        track(pg.ChildAdded:Connect(function(c)
            if matchOver then log("GUI baru: " .. c.Name, COL.warn) end
        end))
    end
    log("Diagnosis tambahan aktif (" .. n .. " event non-RS).")
end

-- Deteksi karakter berpindah jauh (teleport)
task.spawn(function()
    local last
    while alive do
        task.wait(0.5)
        local char = LocalPlayer.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local p = hrp.Position
            if last and (p - last).Magnitude > 80 then
                local near = ""
                for _, a in ipairs(afkParts) do
                    if (p - a.pos).Magnitude < 60 then near = " (dekat " .. a.name .. ")" end
                end
                log(string.format("Karakter pindah %.0f studs -> (%.0f, %.0f, %.0f)%s",
                    (p - last).Magnitude, p.X, p.Y, p.Z, near), COL.bad)
                flushLog()
            end
            last = p
        else
            last = nil
        end
    end
end)

