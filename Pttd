----------------------------------------------------------------
-- PLAY
----------------------------------------------------------------
local function active(tok) return playing and tok == runToken and not matchOver end

local function waitFor(tok, cond)
    while active(tok) and not cond() do task.wait(0.05) end
    return active(tok)
end

-- Jeda acak minimum antar aksi (supaya tidak beruntun terlalu rapat/teratur)
local lastInvoke = 0
local function humanGap()
    local gap = CONFIG.GapMin + math.random() * (CONFIG.GapMax - CONFIG.GapMin)
    local w = lastInvoke + gap - tick()
    if w > 0 then task.wait(w) end
    lastInvoke = tick()
end

local function describe(s)
    local nm = nameById[s.id] or "?"
    if s.type == "place" then return string.format("place #%d %s", s.id, s.name) end
    if s.type == "target" then return string.format("target #%d %s -> %s", s.id, nm, tostring(s.mode)) end
    return string.format("%s #%d %s", s.type, s.id, nm)
end

local function getTowerInst(id, tok)
    for _ = 1, 150 do
        local inst = towerInstances[id]
        if inst and inst.Parent then return inst end
        if not active(tok) then return nil end
        task.wait(0.1)
    end
    return nil
end

local function retryInvoke(tok, label, fn)
    local tries = 0
    while active(tok) do
        local ok, res = pcall(fn)
        if ok and isSuccess(res) then return true, res end
        tries = tries + 1
        if tries == 1 or tries % 10 == 0 then
            log(string.format("%s gagal (percobaan %d), menunggu cash... result: %s",
                label, tries, ok and tostring(res) or "error"), COL.warn)
        end
        local delay = CONFIG.RetryDelay + math.random(20, 60) / 100
        if tries > 5 then delay = math.min(1.2, delay + (tries - 5) * 0.1) end
        task.wait(delay)
    end
    return false
end

local function stopPlay(silent)
    local was = playing
    playing = false
    runToken = runToken + 1
    refreshButtons()
    if was and not silent then log("PLAY dihentikan.", COL.warn) end
end

local function startPlay()
    if #steps == 0 then log("Belum ada makro (Record atau Load dulu).", COL.bad) return end
    if not R.Place then
        log("Bukan di dalam match (remote PlaceTower tidak ada), makro tidak dijalankan.", COL.warn)
        return
    end
    if matchOver then
        log("Match sedang berakhir, makro tidak dijalankan.", COL.warn)
        return
    end
    runToken = runToken + 1
    local tok = runToken
    playing = true
    towerInstances, instToId, claimed, nameById = {}, {}, {}, {}
    for _, s in ipairs(steps) do
        if s.type == "place" then nameById[s.id] = s.name end
    end
    state.waveTime = 0
    lastInvoke = 0
    refreshButtons()
    log("PLAY mulai, " .. #steps .. " step.", COL.ok)

    task.spawn(function()
        for i, s in ipairs(steps) do
            if not active(tok) then break end
            local reached = waitFor(tok, function()
                return state.wave > s.wave or (state.wave == s.wave and state.waveTime >= s.t)
            end)
            if not reached then break end

            humanGap()
            if not active(tok) then break end

            log(string.format("Step %d/%d: %s (rekaman wave %s t=%.1fs)",
                i, #steps, describe(s), tostring(s.wave), s.t))

            if s.type == "place" then
                if not R.Place then log("Remote Place tidak ada.", COL.bad) break end
                local pos = Vector3.new(s.x, s.y, s.z)
                local tries = 0
                local ok = retryInvoke(tok, "Place " .. s.name, function()
                    tries = tries + 1
                    local p = pos
                    -- jitter hanya 2 percobaan pertama; setelah itu pakai posisi asli
                    if CONFIG.PosJitter > 0 and tries <= 2 then
                        local j = CONFIG.PosJitter
                        p = Vector3.new(pos.X + (math.random() * 2 - 1) * j, pos.Y,
                                        pos.Z + (math.random() * 2 - 1) * j)
                    end
                    return R.Place:InvokeServer(s.name, p, s.rot)
                end)
                if ok then
                    log("OK " .. describe(s), COL.ok)
                    bindPlaced(s.id, s.name, pos)
                end
            elseif s.type == "upgrade" or s.type == "sell" then
                local remote = (s.type == "upgrade") and R.Upgrade or R.Sell
                if not remote then log("Remote " .. s.type .. " tidak ada.", COL.bad) break end
                local inst = getTowerInst(s.id, tok)
                if not inst then
                    if active(tok) then log("Tower #" .. s.id .. " tidak ditemukan, step dilewati.", COL.bad) end
                else
                    local ok = retryInvoke(tok, describe(s), function()
                        return remote:InvokeServer(inst)
                    end)
                    if ok then log("OK " .. describe(s), COL.ok) end
                end
            elseif s.type == "target" then
                if not R.Target then log("Remote Target tidak ada.", COL.bad) break end
                local inst = getTowerInst(s.id, tok)
                if not inst then
                    if active(tok) then log("Tower #" .. s.id .. " tidak ditemukan, step dilewati.", COL.bad) end
                else
                    pcall(function() R.Target:FireServer(inst, s.mode) end)
                    log("OK " .. describe(s), COL.ok)
                end
            end
        end

        if tok == runToken and playing then
            playing = false
            refreshButtons()
            log("PLAY selesai.", COL.ok)
        end
    end)
end

