task.spawn(function()
    -- tampilkan log sesi sebelumnya (berguna setelah teleport)
    if prevLog and #prevLog > 0 then
        local lines = {}
        for l in prevLog:gmatch("[^\n]+") do table.insert(lines, l) end
        addLine("== Log sesi sebelumnya (" .. math.min(25, #lines) .. " baris terakhir) ==", COL.warn)
        for i = math.max(1, #lines - 24), #lines do
            addLine(lines[i], Color3.fromRGB(150, 155, 170))
        end
        addLine("== Akhir log sesi sebelumnya (tekan Copy Log untuk menyalin semua) ==", COL.warn)
    end

    -- penulis log ke file (batch tiap 0.5 detik)
    task.spawn(function()
        while alive do
            task.wait(0.5)
            if logDirty then flushLog() end
        end
    end)

    loadSettings()

    if isfile and isfile(CONFIG.OldFile) and delfile then
        pcall(delfile, CONFIG.OldFile)
    end

    for name in pairs(settings.deleted) do
        local p = macroPath(name)
        if isfile and isfile(p) and delfile then pcall(delfile, p) end
        if not (isfile and isfile(p)) then settings.deleted[name] = nil end
    end
    if settings.selected and settings.deleted[settings.selected] then
        settings.selected = nil
    end
    saveSettings()

    setAutoPlay(settings.autoPlay, true)
    setAutoReplay(settings.autoReplay, true)
    setSpeed15(settings.autoSpeed == 1.5, true)
    setSpeed2(settings.autoSpeed == 2, true)
    setAutoVote(settings.autoVote, true)
    setAntiAfkToggle(settings.antiAfk, true)
    setAntiAfk(settings.antiAfk)
    diffBtn.Text = "Diff: " .. tostring(settings.difficulty)

    if settings.selected then
        local d = readMacro(settings.selected)
        if d then
            steps = d
            activeName, selectedName = settings.selected, settings.selected
            nameBox.Text = settings.selected
            log("Makro aktif: " .. settings.selected .. " (" .. #steps .. " step)", COL.ok)
        else
            log("Makro '" .. tostring(settings.selected) .. "' tidak ditemukan.", COL.bad)
            settings.selected = nil
            saveSettings()
        end
    end
    refreshList()
    refreshButtons()
    pcall(monitorAfkRemotes)
    pcall(watchServerEvents)
    pcall(findAfkParts)
    pcall(watchPlayerAfk)
    pcall(watchExtra)
    log("TD Macro v2.6 siap." .. (settings.antiAfk and " Anti AFK ON." or ""), COL.ok)

    task.wait(3)
    if not alive then return end
    if settings.autoSpeed > 0 then applySpeed() end
    scheduleVote()
    if settings.autoPlay and #steps > 0 and not recording then
        for _ = 1, 10 do
            if not scanEndUI().ended then break end
            task.wait(1)
        end
        if alive and not matchOver then
            log("Auto Play makro: " .. tostring(activeName), COL.ok)
            startPlay()
        end
    end
end)
