local Shared = env.__TDMacroShared2
if not Shared then
    Shared = { recording = false, handlers = {} }
    env.__TDMacroShared2 = Shared
    if hookmetamethod and getnamecallmethod and newcclosure and checkcaller then
        local old
        old = hookmetamethod(game, "__namecall", newcclosure(function(self, ...)
            local method = getnamecallmethod()
            if method == "InvokeServer" or method == "FireServer" then
                local h = Shared.handlers and Shared.handlers[self]
                if h and h.method == method and (Shared.recording or h.all) then
                    local mine = checkcaller()
                    if h.all or not mine then
                        local args = { ... }
                        local st = Shared.state
                        local wave, t = st.wave, st.waveTime
                        if method == "InvokeServer" then
                            local res = table.pack(old(self, ...))
                            task.spawn(h.cb, args, res, wave, t, mine)
                            return table.unpack(res, 1, res.n)
                        else
                            old(self, ...)
                            task.spawn(h.cb, args, nil, wave, t, mine)
                            return
                        end
                    end
                end
            end
            return old(self, ...)
        end))
    else
        task.defer(function() log("Executor tidak support hookmetamethod, Record tidak bisa.", COL.bad) end)
    end
end

local function recPlace(args, res, wave, t)
    if not recording then return end
    local name, pos, rot = args[1], args[2], args[3]
    if type(name) ~= "string" or typeof(pos) ~= "Vector3" then return end
    local first = res[1]
    if not isSuccess(first) then
        log(string.format("GAGAL place %s (tidak direkam) | result: %s", name, tostring(first)), COL.bad)
        return
    end
    local count = 0
    for _, s in ipairs(steps) do if s.type == "place" then count = count + 1 end end
    local id = count + 1
    nameById[id] = name
    table.insert(steps, {
        type = "place", id = id, name = name,
        x = pos.X, y = pos.Y, z = pos.Z, rot = rot or 0, wave = wave, t = t,
    })
    log(string.format("RECORD place #%d %s @ (%.1f, %.1f, %.1f) | wave %s t=%.1fs",
        id, name, pos.X, pos.Y, pos.Z, tostring(wave), t), COL.ok)
    bindPlaced(id, name, pos)
end

local function recUS(kind)
    return function(args, res, wave, t)
        if not recording then return end
        local inst = args[1]
        if typeof(inst) ~= "Instance" then return end
        if not isSuccess(res[1]) then
            log(string.format("GAGAL %s %s (tidak direkam) | result: %s", kind, inst.Name, tostring(res[1])), COL.bad)
            return
        end
        local id = resolveId(inst)
        if not id then
            log(string.format("%s berhasil tapi tower tidak dikenali (tidak direkam): %s", kind, inst.Name), COL.bad)
            return
        end
        table.insert(steps, { type = kind, id = id, wave = wave, t = t })
        log(string.format("RECORD %s #%d %s | wave %s t=%.1fs", kind, id, nameById[id] or inst.Name, tostring(wave), t), COL.ok)
    end
end

local function recTarget(args, _, wave, t)
    if not recording then return end
    local inst, mode = args[1], args[2]
    if typeof(inst) ~= "Instance" or type(mode) ~= "string" then return end
    local id = resolveId(inst)
    if not id then
        log("Target diubah tapi tower tidak dikenali (tidak direkam): " .. inst.Name, COL.bad)
        return
    end
    table.insert(steps, { type = "target", id = id, mode = mode, wave = wave, t = t })
    log(string.format("RECORD target #%d %s -> %s | wave %s t=%.1fs", id, nameById[id] or inst.Name, mode, tostring(wave), t), COL.ok)
end

local function onSpeedSeen(args, _, _, _, mine)
    local v = tonumber(args[1])
    if v then
        state.remoteSpeed = v
        if not mine then log("Speed game -> x" .. tostring(v)) end
    end
end

