    if name == "" then log("Isi nama makro dulu.", COL.warn) return end
    if #steps == 0 then log("Tidak ada step untuk disimpan.", COL.warn) return end
    saveMacro(name)
end)

delBtn.MouseButton1Click:Connect(function()
    if recording or playing then log("Stop Record/Play dulu.", COL.warn) return end
    local name = settings.macro
    if name == "" then log("Pilih makro dulu (◀ ▶).", COL.warn) return end
    deleteMacro(name)
end)

-- Tab Auto
local toggleRefresh = {}
local function refreshToggles()
    for _, f in ipairs(toggleRefresh) do f() end
end

local function mkToggle(label, y, w, getOn, onToggle)
    local b = makeBtn(tabAuto, label, 8, y, w, 24, C_GRAY)
    b.TextSize = 12
    local function refresh()
        local on = getOn()
        b.Text = label .. ": " .. (on and "ON" or "OFF")
        b.BackgroundColor3 = on and C_ON or C_GRAY
    end
    table.insert(toggleRefresh, refresh)
    b.MouseButton1Click:Connect(function()
        onToggle()
        saveSettings()
        refreshToggles()
    end)
    refresh()
    return b
end

mkToggle("Auto Play (Rejoin)", 0, 284,
    function() return settings.autoPlay end,
    function() settings.autoPlay = not settings.autoPlay end)

mkToggle("Auto Speed x1.5", 25, 284,
    function() return settings.autoSpeed == 1.5 end,
    function() settings.autoSpeed = (settings.autoSpeed == 1.5) and 0 or 1.5 end)

mkToggle("Auto Speed x2", 50, 284,
    function() return settings.autoSpeed == 2 end,
    function() settings.autoSpeed = (settings.autoSpeed == 2) and 0 or 2 end)

mkToggle("Auto Replay Match", 75, 284,
    function() return settings.autoReplay end,
    function() settings.autoReplay = not settings.autoReplay end)

mkToggle("Auto Vote", 100, 190,
    function() return settings.autoVote end,
    function()
        settings.autoVote = not settings.autoVote
        if settings.autoVote then scheduleVote(CONFIG.VoteDelay) end
    end)

local diffBtn = makeBtn(tabAuto, settings.difficulty, 202, 100, 90, 24, C_GRAY)
diffBtn.TextSize = 12
diffBtn.MouseButton1Click:Connect(function()
    local i = table.find(DIFFS, settings.difficulty) or 1
    settings.difficulty = DIFFS[(i % #DIFFS) + 1]
    diffBtn.Text = settings.difficulty
    saveSettings()
    if settings.autoVote then scheduleVote(CONFIG.VoteDelay) end
end)

