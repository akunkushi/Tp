-- MATCH-END GUARD + AUTO REPLAY
----------------------------------------------------------------
local endedUntil = 0

local function markMatchOver(why)
    if matchOver then return end
    matchOver = true
    lastEnd = tick()
    if playing then
        stopPlay(true)
        log("Match selesai (" .. tostring(why) .. "), makro dihentikan.", COL.warn)
    else
        log("Fase akhir match (" .. tostring(why) .. ").", COL.warn)
    end
end

local END_PATS = {"matchend", "gameend", "endgame", "gameover", "matchresult", "matchover", "matchfinish", "victory", "defeat", "result"}
do
    local roots = { ReplicatedStorage }
    local rf = ReplicatedStorage:FindFirstChild(CONFIG.RemoteFolder)
    if rf then table.insert(roots, rf) end
    for _, root in ipairs(roots) do
        for _, r in ipairs(root:GetChildren()) do
            if r:IsA("RemoteEvent") and hasName(r.Name, END_PATS, false) then
                track(r.OnClientEvent:Connect(function()
                    endedUntil = tick() + 20
                    log("Event match selesai dari remote: " .. r.Name, COL.warn)
                    markMatchOver("remote " .. r.Name)
                end))
                log("Memantau remote match-end: " .. r.Name)
            end
        end
    end
end

local FRAME_PATS = {"victory", "defeat", "gameover", "matchresult", "endscreen", "matchend", "gameend", "resultsscreen"}
local BTN_NAMES  = { again = true, playagain = true, replay = true }

local function ancestorHas(d, pats)
    local cur = d.Parent
    for _ = 1, 4 do
        if not cur or cur == game then return false end
        if hasName(cur.Name, pats, false) then return true end
        cur = cur.Parent
    end
    return false
end

local function scanEndUI()
    local r = { ended = false }
    if CONFIG.IsMatchEnded then
        local ok, v = pcall(CONFIG.IsMatchEnded)
        if ok and v then r.ended, r.why = true, "config" end
    end
    if tick() < endedUntil then r.ended, r.why = true, r.why or "remote event" end

    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return r end
    local ownInPg = gui:IsDescendantOf(pg)

    for _, d in ipairs(pg:GetDescendants()) do
        if not (ownInPg and d:IsDescendantOf(gui)) then
            if d:IsA("GuiButton") then
                local txt = d:IsA("TextButton") and string.lower(stripTags(d.Text)) or ""
                local n = string.lower(d.Name)
                if (BTN_NAMES[n] or txt == "again" or txt == "replay"
                    or string.find(txt, "play again", 1, true)) and isVisible(d) then
                    r.ended, r.button = true, d
                    r.why = r.why or ("tombol " .. d.Name)
                end
            elseif d:IsA("TextLabel") then
                local txt = string.lower(stripTags(d.Text))
                if string.find(txt, "again", 1, true) and isVisible(d) then
                    r.ended = true
                    r.why = r.why or ("teks " .. d.Name)
                    local v, t = txt:match("(%d+)%s*/%s*(%d+)")
                    if v then r.voted, r.total = tonumber(v), tonumber(t) end
                elseif not r.voted then
                    local v, t = txt:match("^%s*(%d+)%s*/%s*(%d+)%s*$")
                    if v and ancestorHas(d, {"again", "replay"}) and isVisible(d) then
                        r.voted, r.total = tonumber(v), tonumber(t)
                    end
                end
            elseif (d:IsA("GuiObject") or d:IsA("ScreenGui"))
                and hasName(d.Name, FRAME_PATS, false) and isVisible(d) then
                r.ended = true
                r.why = r.why or ("UI " .. d.Name)
            end
        end
    end
    return r
end

local replaying = false
local lastReplay = 0

-- Kirim "Again" SEKALI (vote bisa bersifat toggle, jadi tidak boleh di-spam).
-- Kirim ulang (maks 1x) hanya jika counter vote terbaca dan masih 0 setelah 6 detik.
local function doReplay(why)
    replaying = true
    if not R.Match then
        log("Remote MatchAction tidak ada.", COL.bad)
        replaying = false
        return
    end
    log("Match selesai (" .. tostring(why) .. "), mengirim Again (1x)...", COL.warn)

    local sent, sentAt, missing, t0 = 0, 0, 0, tick()
    while alive and settings.autoReplay do
        local r = scanEndUI()
        if not r.ended then
            missing = missing + 1
            if missing >= 2 then
                log("Layar akhir hilang, replay dianggap berhasil.", COL.ok)
                break
            end
        else
            missing = 0
            if r.voted and r.total and r.total > 0 and r.voted >= r.total then
                log(string.format("Vote Again tercatat (%d/%d).", r.voted, r.total), COL.ok)
                break
            end
            if sent == 0 then
                pcall(function() R.Match:FireServer("Again") end)
                sent, sentAt = 1, tick()
                log("Auto replay: Again", COL.ok)
            elseif sent == 1 and r.total and r.voted == 0 and tick() - sentAt >= 6 then
                pcall(function() R.Match:FireServer("Again") end)
                sent, sentAt = 2, tick()
                log(string.format("Vote masih %d/%d setelah 6 detik, kirim Again sekali lagi.",
                    r.voted, r.total), COL.warn)
            end
            if tick() - t0 > 40 then break end
        end
        task.wait(1)
    end

    lastReplay = tick()
    endedUntil = 0
    replaying = false
end

local endStreak = 0
task.spawn(function()
    while alive do
        task.wait(1)
        local r = scanEndUI()
        if r.ended then
            endStreak = endStreak + 1
            if endStreak >= 2 or r.why == "remote event" then
                markMatchOver(r.why)
            end
            if settings.autoReplay and not replaying and tick() - lastReplay > 20 then
                task.spawn(doReplay, r.why)
            end
        else
            endStreak = 0
            if matchOver and tick() - lastEnd > 3 then
                matchOver = false
            end
        end
    end
end)

task.spawn(function()
    while alive do
        task.wait(20)
        if settings.autoSpeed > 0 and not matchOver then
            pcall(function() SpeedRemote:FireServer(settings.autoSpeed) end)
            state.remoteSpeed = settings.autoSpeed
        end
    end
end)

local function onNewMatch()
    task.wait(3)
    if not alive then return end
    if matchOver or (tick() - lastEnd) < 5 or state.wave > 1 or scanEndUI().ended then
        log("Wave kembali ke awal saat fase akhir match, diabaikan (bukan match baru).", COL.warn)
        return
    end
    log("Match baru terdeteksi.", COL.warn)
    endedUntil = 0
    if not recording then
        towerInstances, instToId, claimed = {}, {}, {}
    end
    if settings.autoSpeed > 0 then task.delay(2, applySpeed) end
    scheduleVote()
    if settings.autoPlay and #steps > 0 and not recording then
        stopPlay(true)
        task.delay(0.5, function() if alive and not recording then startPlay() end end)
    end
end

