local function makeToggle(label, x, y, w, onChange)
    local b = btn(pageAuto, label, x, y, w, 28, C.gray, 12)
    local on = false
    local function set(v, silent)
        on = v and true or false
        b.Text = label .. ": " .. (on and "ON" or "OFF")
        b.BackgroundColor3 = on and C.green or C.gray
        if not silent and onChange then onChange(on) end
    end
    b.MouseButton1Click:Connect(function() set(not on) end)
    set(false, true)
    return set
end

