local function parseNum(s)
    if type(s) == "number" then return s end
    s = tostring(s):gsub(",", "")
    local n = s:match("%-?%d+%.?%d*")
    return n and tonumber(n) or nil
end

local function hasName(name, pats, exact)
    local n = string.lower(name)
    for _, p in ipairs(pats) do
        if exact then
            if n == p then return true end
        elseif string.find(n, p, 1, true) then
            return true
        end
    end
    return false
end

local function readAny(v)
    if typeof(v) == "Instance" then
        local ok, val = pcall(function() return v.Value end)
        if not ok then return nil end
        v = val
    end
    if type(v) == "number" then return v end
    if type(v) == "string" then return parseNum(v) end
    return nil
end

-- Apakah GUI object benar-benar terlihat (semua parent visible/enabled)
local function guiVisible(o)
    local cur = o
    while cur and cur ~= game do
        if cur:IsA("GuiObject") and not cur.Visible then return false end
        if cur:IsA("ScreenGui") then return cur.Enabled end
        cur = cur.Parent
    end
    return true
end

-- Apakah objek berada di UI pemilihan difficulty / lobby / reward (bukan HUD wave asli)
local function isRejectedWaveObj(d)
    local cur = d
    while cur and cur ~= game do
        if cur:IsA("GuiObject") or cur:IsA("ScreenGui") or cur:IsA("Folder") then
            if hasName(cur.Name, CONFIG.WaveRejectWords, false) then return true end
        end
        cur = cur.Parent
    end
    -- teks seperti "20 Waves" / "40 Waves" = info difficulty, bukan wave berjalan
    if d:IsA("TextLabel") or d:IsA("TextButton") then
        local t = string.lower(tostring(d.Text))
        if t:match("%d+%s*waves") then return true end
    end
    return false
end

-- Deteksi fase pemilihan difficulty (panel vote sedang tampil)
local votePanel, lastVP = nil, 0
local function isVoting()
    if CONFIG.IsVoting then
        local ok, v = pcall(CONFIG.IsVoting)
        return ok and v and true or false
    end
    if not votePanel or not votePanel.Parent then
        votePanel = nil
        if tick() - lastVP > 1 then
            lastVP = tick()
            local pg = LocalPlayer:FindFirstChild("PlayerGui")
            if pg then votePanel = pg:FindFirstChild(CONFIG.VotePanelName, true) end
        end
    end
    if votePanel and votePanel.Parent then
        return guiVisible(votePanel)
    end
    return false
end

local function makeFinder(label, pats, exactOnly, reject)
    local fn, lastSearch = nil, 0

    local function search()
        for pass = 1, (exactOnly and 1 or 2) do
            local exact = (pass == 1)
            for _, root in ipairs({LocalPlayer, ReplicatedStorage}) do
                for _, d in ipairs(root:GetDescendants()) do
                    if d:IsA("ValueBase") and hasName(d.Name, pats, exact)
                    and not (reject and reject(d)) and readAny(d) ~= nil then
                        log(label .. " terdeteksi: " .. d:GetFullName(), COL.warn)
                        return function()
                            if reject and reject(d) then return nil end
                            return readAny(d)
                        end
                    end
                end
            end
            for _, root in ipairs({LocalPlayer, ReplicatedStorage, workspace}) do
                for k, v in pairs(root:GetAttributes()) do
                    if hasName(k, pats, exact) and readAny(v) ~= nil then
                        log(label .. " terdeteksi: attribute " .. k .. " di " .. root.Name, COL.warn)
                        return function() return readAny(root:GetAttribute(k)) end
                    end
                end
            end
            local pg = LocalPlayer:FindFirstChild("PlayerGui")
            if pg then
                for _, d in ipairs(pg:GetDescendants()) do
                    if (d:IsA("TextLabel") or d:IsA("TextButton"))
                    and hasName(d.Name, pats, exact)
                    and not d:IsDescendantOf(gui)
                    and not (reject and reject(d))
                    and parseNum(d.Text) ~= nil then
                        log(label .. " terdeteksi: UI " .. d:GetFullName(), COL.warn)
                        return function()
                            if reject and reject(d) then return nil end
                            return parseNum(d.Text)
                        end
                    end
                end
            end
        end
        return nil
    end

    return function()
        if fn then
            local ok, v = pcall(fn)
            if ok and v ~= nil then return v end
            fn = nil -- label ditolak / hilang -> cari ulang
        end
        if tick() - lastSearch > 3 then
            lastSearch = tick()
            local ok, f = pcall(search)
            if ok and f then
                fn = f
                local ok2, v = pcall(fn)
                if ok2 then return v end
            end
        end
        return nil
    end
end

local findCash  = makeFinder("Cash",  CONFIG.CashNames)
local findWave  = makeFinder("Wave",  CONFIG.WaveNames, false, isRejectedWaveObj)
local findSpeed = makeFinder("Speed", CONFIG.SpeedNames, true)

local function safeCall(f, fallback)
    local ok, v = pcall(f)
    if ok and v ~= nil then return readAny(v) or v end
    return fallback
end

