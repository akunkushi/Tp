-- PLAY
----------------------------------------------------------------
local function waitFor(cond, token)
    while playing and playToken == token and not cond() do task.wait(0.05) end
    return playing and playToken == token
end

local function resolveTower(id, token, timeout)
    local deadline = tick() + (timeout or 3)
    repeat
        local inst = towerInstances[id]
        if inst and inst.Parent then return inst end
        local info = placeInfo[id]
        if info and placedOk[id] then
            local f = findTowerNear(info.name, Vector3.new(info.x, info.y, info.z))
            if f then
                towerInstances[id] = f
                instToId[f] = id
                return f
            end
        end
        task.wait(0.1)
    until tick() > deadline or not (playing and playToken == token)
    return towerInstances[id]
end

local function retryCall(token, label, kind, maxTries, fn)
    local tries = 0
    while playing and playToken == token do
        local ok, res = pcall(fn)
        if ok and isSuccess(res, kind) then return true, res end
        tries = tries + 1
        if tries == 1 or tries % 10 == 0 then
            log(string.format("%s gagal (percobaan %d), menunggu... result: %s",
                label, tries, tostring(res)), COL.warn)
        end
        if maxTries > 0 and tries >= maxTries then return false, res end
        task.wait(CONFIG.RetryDelay)
    end
    return false
end

local function runStep(i, s, token)
    local total = #steps
    if s.type == "place" then
        if not PlaceRemote then return end
        log(string.format("Step %d/%d: place %s (rekaman wave %s t=%.1fs)",
            i, total, s.name, tostring(s.wave), s.t))
        local pos = Vector3.new(s.x, s.y, s.z)
        local ok, res = retryCall(token, "Place " .. s.name, "place", CONFIG.PlaceMaxTries, function()
            return PlaceRemote:InvokeServer(s.name, pos, s.rot)
        end)
        if ok then
            placedOk[s.id] = true
            log(string.format("OK place #%s %s | result: %s", tostring(s.id), s.name, tostring(res)), COL.ok)
            bindTower(s.id, s.name, pos)
        end

    elseif s.type == "upgrade" then
        if not UpgradeRemote then return end
        if not placedOk[s.id] then
            log(string.format("Step %d/%d: upgrade #%s dilewati (tower belum/tidak ter-place)", i, total, tostring(s.id)), COL.warn)
            return
        end
        local inst = resolveTower(s.id, token, 4)
        if not inst then
            log(string.format("Step %d/%d: upgrade #%s dilewati (instance tidak ketemu)", i, total, tostring(s.id)), COL.bad)
            return
        end
        log(string.format("Step %d/%d: upgrade #%s", i, total, tostring(s.id)))
        local ok, res = retryCall(token, "Upgrade #" .. tostring(s.id), "upgrade", CONFIG.UpgradeMaxTries, function()
            return UpgradeRemote:InvokeServer(inst)
        end)
        if ok then
            log(string.format("OK upgrade #%s | result: %s", tostring(s.id), tostring(res)), COL.ok)
        elseif playing and playToken == token then
            log(string.format("Upgrade #%s dilewati (batas percobaan) | result: %s", tostring(s.id), tostring(res)), COL.warn)
        end

    elseif s.type == "sell" then
        if not SellRemote then return end
        if not placedOk[s.id] then
            log(string.format("Step %d/%d: sell #%s dilewati (tower tidak ada)", i, total, tostring(s.id)), COL.warn)
            return
        end
        local inst = resolveTower(s.id, token, 4)
        if not inst then
            log(string.format("Step %d/%d: sell #%s dilewati (instance tidak ketemu)", i, total, tostring(s.id)), COL.bad)
            return
        end
        log(string.format("Step %d/%d: sell #%s", i, total, tostring(s.id)))
        local ok, res = retryCall(token, "Sell #" .. tostring(s.id), "sell", CONFIG.SellMaxTries, function()
            return SellRemote:InvokeServer(inst)
        end)
        if ok then
            placedOk[s.id] = false
            towerInstances[s.id] = nil
            log(string.format("OK sell #%s | result: %s", tostring(s.id), tostring(res)), COL.ok)
        elseif playing and playToken == token then
            log(string.format("Sell #%s gagal | result: %s", tostring(s.id), tostring(res)), COL.bad)
        end

    elseif s.type == "target" then
        if not TargetRemote or not placedOk[s.id] then return end
        local inst = resolveTower(s.id, token, 4)
        if not inst then
            log(string.format("Step %d/%d: target #%s dilewati (instance tidak ketemu)", i, total, tostring(s.id)), COL.bad)
            return
        end
        pcall(function() TargetRemote:FireServer(inst, s.mode) end)
        log(string.format("OK target #%s -> %s", tostring(s.id), tostring(s.mode)), COL.ok)
    end
end

stopPlay = function(silent)
    if not playing then return end
    playing = false
    playToken = playToken + 1
    refreshButtons()
    if not silent then log("PLAY dihentikan.", COL.warn) end
end

playMacro = function()
    if #steps == 0 then
        log("Belum ada rekaman / makro belum dimuat.", COL.bad)
        return
    end
    if not PlaceRemote then log("Remote tidak ada.", COL.bad) return end

    playToken = playToken + 1
    local token = playToken
    playing = true
    towerInstances, instToId, claimed, placeInfo, placedOk = {}, {}, {}, {}, {}
    for _, s in ipairs(steps) do
        if s.type == "place" then placeInfo[s.id] = s end
    end
    state.waveTime = 0
    refreshButtons()
    log("PLAY mulai, " .. #steps .. " step (" .. summary(steps) .. ").", COL.ok)

    task.spawn(function()
        for i, s in ipairs(steps) do
            if not (playing and playToken == token) then break end
            local reached = waitFor(function()
                return state.wave > s.wave or (state.wave == s.wave and state.waveTime >= s.t)
            end, token)
            if not reached then break end
            runStep(i, s, token)
        end
        if playToken == token then
            if playing then log("PLAY selesai.", COL.ok) end
            playing = false
            refreshButtons()
        end
    end)
end

onNewMatch = function()
    towerInstances, instToId, claimed, active = {}, {}, {}, {}
    log("Match baru terdeteksi.", COL.warn)
    if recording then return end
    if playing then
        stopPlay(true)
        task.wait(0.3)
        playMacro()
    elseif settings.autoPlay and #steps > 0 then
        playMacro()
    end
end

