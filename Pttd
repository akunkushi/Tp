local function readJson(path)
    if isfile and readfile and isfile(path) then
        local ok, d = pcall(function() return HttpService:JSONDecode(readfile(path)) end)
        if ok and type(d) == "table" then return d end
    end
    return nil
end

local function writeJson(path, tbl)
    if not writefile then return false end
    local ok = pcall(function() writefile(path, HttpService:JSONEncode(tbl)) end)
    return ok
end

local function saveSettings() writeJson(CONFIG.SettingsFile, settings) end

local function loadSettings()
    local d = readJson(CONFIG.SettingsFile)
    if d then
        for k, v in pairs(d) do
            if settings[k] ~= nil then settings[k] = v end
        end
    end
    if type(settings.index) ~= "table" then settings.index = {} end
    if type(settings.deleted) ~= "table" then settings.deleted = {} end
    if type(settings.autoSpeed) ~= "number" then settings.autoSpeed = 0 end
    if not table.find(DIFFS, settings.difficulty) then settings.difficulty = "Medium" end
end

local function ensureDir()
    if makefolder and isfolder and not isfolder(CONFIG.MacroDir) then
        pcall(makefolder, CONFIG.MacroDir)
    end
end

local function sanitize(n)
    n = tostring(n or "")
    n = n:gsub("[^%w_%-%s]", "")
    n = n:gsub("^%s+", ""):gsub("%s+$", "")
    return n
end

local function macroPath(name) return CONFIG.MacroDir .. "/" .. name .. ".json" end

local function addIndex(name)
    if not table.find(settings.index, name) then table.insert(settings.index, name) end
end
local function removeIndex(name)
    local i = table.find(settings.index, name)
    if i then table.remove(settings.index, i) end
end

-- Daftar makro yang sudah dihapus (supaya tidak muncul lagi walau file gagal terhapus)
local function isDeleted(name)
    return table.find(settings.deleted, name) ~= nil
end
local function markDeleted(name)
    if not isDeleted(name) then table.insert(settings.deleted, name) end
end
local function unmarkDeleted(name)
    local i = table.find(settings.deleted, name)
    while i do
        table.remove(settings.deleted, i)
        i = table.find(settings.deleted, name)
    end
end

local function listMacros()
    local out = {}
    if listfiles and isfolder and isfolder(CONFIG.MacroDir) then
        local ok, files = pcall(listfiles, CONFIG.MacroDir)
        if ok and type(files) == "table" then
            for _, f in ipairs(files) do
                local n = tostring(f):match("([^/\\]+)%.json$")
                if n and not isDeleted(n) and not table.find(out, n) then
                    table.insert(out, n)
                end
            end
        end
    else
        for _, n in ipairs(settings.index) do
            if not isDeleted(n) and not table.find(out, n) then
                table.insert(out, n)
            end
        end
    end
    table.sort(out, function(a, b) return string.lower(a) < string.lower(b) end)
    return out
end

local function summary(list)
    local p, u, s, t = 0, 0, 0, 0
    for _, st in ipairs(list) do
        if st.type == "place" then p = p + 1
        elseif st.type == "upgrade" then u = u + 1
        elseif st.type == "sell" then s = s + 1
        elseif st.type == "target" then t = t + 1 end
    end
    return string.format("%d place, %d upgrade, %d sell, %d target", p, u, s, t)
end

local macroList, macroIdx = {}, 0
local function refreshMacroLabel()
    macroList = listMacros()
    macroIdx = table.find(macroList, settings.macro) or 0
    if #macroList == 0 then
        macroLabel.Text = "Belum ada makro tersimpan"
    elseif macroIdx > 0 then
        macroLabel.Text = string.format("%s (%d/%d) · %d step", settings.macro, macroIdx, #macroList, #steps)
    else
        macroLabel.Text = string.format("(pilih makro) 0/%d · %d step", #macroList, #steps)
    end
end

local function saveMacro(name)
    ensureDir()
    local ok = writeJson(macroPath(name), { version = 2, steps = steps })
    if ok then
        unmarkDeleted(name) -- disimpan ulang = tidak lagi dianggap terhapus
        addIndex(name)
        settings.macro = name
        nameBox.Text = name
        saveSettings()
        refreshMacroLabel()
        log("Makro disimpan: " .. name .. " (" .. summary(steps) .. ")", COL.ok)
    else
        log("Gagal menyimpan makro (executor tanpa writefile?)", COL.bad)
    end
    return ok
end

local function loadMacro(name)
    local d = readJson(macroPath(name))
    if not d then log("Gagal memuat makro: " .. tostring(name), COL.bad) return false end
    steps = d.steps or d -- format lama = array langsung
    settings.macro = name
    nameBox.Text = name
    saveSettings()
    refreshMacroLabel()
    log("Makro dimuat: " .. name .. " (" .. summary(steps) .. ")", COL.ok)
    return true
end

local function deleteMacro(name)
    local path = macroPath(name)
    local fileGone = false

    -- 1) coba hapus file sungguhan
    if delfile then pcall(delfile, path) end
    if isfile then
        local ok, exists = pcall(isfile, path)
        fileGone = ok and not exists
    end

    -- 2) jika file masih ada, kosongkan isinya
    if not fileGone and writefile then
        pcall(writefile, path, "{}")
    end

    -- 3) catat sebagai terhapus + bersihkan index, lalu simpan permanen
    markDeleted(name)
    removeIndex(name)
    settings.macro = ""
    steps = {}
    nameBox.Text = ""
    saveSettings()
    refreshMacroLabel()

    if fileGone then
        log("Makro dihapus: " .. name, COL.warn)
    else
        log("Makro dihapus: " .. name .. " (file tidak bisa dihapus executor, disembunyikan permanen)", COL.warn)
    end
end

