----------------------------------------------------------------
track(RunService.Heartbeat:Connect(function(dt)
    state.waveTime = state.waveTime + dt * state.speed
end))

task.spawn(function()
    local lastNewMatch = 0
    local wasVoting = false
    while alive do
        local c = CONFIG.GetCash and safeCall(CONFIG.GetCash) or findCash()
        if type(c) == "number" then state.cash = c end

        local s = CONFIG.GetSpeed and safeCall(CONFIG.GetSpeed) or findSpeed()
        if type(s) == "number" and s >= 0.25 and s <= 10 then
            state.speedDetected = s
        else
            state.speedDetected = nil
        end

        if type(speedMode) == "number" then
            state.speed = speedMode
        elseif state.speedDetected then
            state.speed = state.speedDetected
        elseif settings.autoSpeed > 0 and firedSpeed then
            state.speed = firedSpeed
        else
            state.speed = 1
        end

        -- Fase pemilihan difficulty: wave dipaksa 0, jangan baca wave apa pun
        local voting = isVoting()
        if voting then
            if state.wave ~= 0 then
                state.wave = 0
                log("Fase pilih difficulty (wave diabaikan)", COL.warn)
            end
            state.waveTime = 0
        elseif wasVoting then
            -- panel vote hilang = match benar-benar dimulai
            state.waveTime = 0
            if tick() - lastNewMatch > 5 then
                lastNewMatch = tick()
                if onNewMatch then task.spawn(onNewMatch) end
            end
        end
        wasVoting = voting

        if not voting then
            local w = CONFIG.GetWave and safeCall(CONFIG.GetWave) or findWave()
            if type(w) == "number" then
                waveDetected = true
                if w ~= state.wave then
                    local prev = state.wave
                    state.wave = w
                    state.waveTime = 0
                    log("Wave berganti -> " .. tostring(w))
                    -- wave turun ke awal = match baru
                    if w < prev and w <= 1 and tick() - lastNewMatch > 5 then
                        lastNewMatch = tick()
                        if onNewMatch then task.spawn(onNewMatch) end
                    end
                end
            end
        end

        info.Text = string.format("Wave %s | Cash %s | x%s%s",
            tostring(state.wave), fmtCash(state.cash), tostring(state.speed),
            type(speedMode) == "number" and "" or " (auto)")
        task.wait(0.1)
    end
end)

