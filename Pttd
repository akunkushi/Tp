----------------------------------------------------------------
-- TOWER TRACKING
----------------------------------------------------------------
local function pivotPos(inst)
    local ok, cf = pcall(function() return inst:GetPivot() end)
    return ok and cf.Position or nil
end
local function xzDist(a, b) return Vector2.new(a.X - b.X, a.Z - b.Z).Magnitude end
local function isOwnTower(inst)
    local prefix = string.lower(LocalPlayer.Name) .. "_"
    return string.lower(inst.Name):sub(1, #prefix) == prefix
end

local function findTowerNear(name, pos)
    local folder = workspace:FindFirstChild("Towers")
    if not folder then return nil end
    local best, bestD
    for pass = 1, 2 do
        for _, inst in ipairs(folder:GetChildren()) do
            if not claimed[inst] and (pass == 2 or isOwnTower(inst))
            and string.find(string.lower(inst.Name), string.lower(name), 1, true) then
                local p = pivotPos(inst)
                if p then
                    local d = xzDist(p, pos)
                    if d < 8 and (not bestD or d < bestD) then best, bestD = inst, d end
                end
            end
        end
        if best then break end
    end
    return best
end

local function bindPlaced(id, name, pos)
    task.spawn(function()
        for _ = 1, 40 do
            if towerInstances[id] or not alive then return end
            local inst = findTowerNear(name, pos)
            if inst then
                claimed[inst] = true
                towerInstances[id] = inst
                instToId[inst] = id
                return
            end
            task.wait(0.1)
        end
    end)
end

local function resolveId(inst)
    if instToId[inst] then return instToId[inst] end
    local p = pivotPos(inst)
    if not p then return nil end
    local bestId, bestD
    for _, s in ipairs(steps) do
        if s.type == "place" and not towerInstances[s.id] then
            local d = xzDist(p, Vector3.new(s.x, s.y, s.z))
            if d < 8 and (not bestD or d < bestD) then bestId, bestD = s.id, d end
        end
    end
    if bestId then
        towerInstances[bestId] = inst
        instToId[inst] = bestId
        claimed[inst] = true
    end
    return bestId
end

