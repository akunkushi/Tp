-- POLLING + WAKTU (tidak terpengaruh speed)
----------------------------------------------------------------
track(RunService.Heartbeat:Connect(function(dt)
    state.waveTime = state.waveTime + dt * state.speed
end))

task.spawn(function()
    while alive do
        local c = CONFIG.GetCash and safeCall(CONFIG.GetCash) or findCash()
        if type(c) == "number" then state.cash = c end

        local sp
        if type(speedMode) == "number" then
            sp = speedMode
        elseif state.remoteSpeed then
            sp = state.remoteSpeed
        else
            sp = CONFIG.GetSpeed and safeCall(CONFIG.GetSpeed) or findSpeed()
        end
        if type(sp) ~= "number" or sp < 0.25 or sp > 10 then sp = 1 end
        state.speed = sp

        local w = CONFIG.GetWave and safeCall(CONFIG.GetWave) or findWave()
        if type(w) == "number" and w ~= state.wave then
            local oldW = state.wave
            state.wave = w
            state.waveTime = 0
            log("Wave berganti -> " .. tostring(w))
            if w < oldW and w <= 1 then task.spawn(onNewMatch) end
        end

        info.Text = string.format("W%s | $%s | x%s%s | %s%s",
            tostring(state.wave), fmtCash(state.cash), tostring(state.speed),
            type(speedMode) == "number" and "(m)" or "", activeName or "-",
            matchOver and " | END" or "")
        task.wait(0.1)
    end
end)

