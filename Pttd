local function makeFinder(label, pats, exactOnly)
    local fn, lastSearch = nil, 0
    local function search()
        for pass = 1, (exactOnly and 1 or 2) do
            local exact = (pass == 1)
            for _, root in ipairs({LocalPlayer, ReplicatedStorage}) do
                for _, d in ipairs(root:GetDescendants()) do
                    if d:IsA("ValueBase") and hasName(d.Name, pats, exact) and readAny(d) ~= nil then
                        log(label .. " terdeteksi: " .. d:GetFullName(), COL.warn)
                        return function() return readAny(d) end
                    end
                end
            end
            for _, root in ipairs({LocalPlayer, ReplicatedStorage, workspace}) do
                for k, v in pairs(root:GetAttributes()) do
                    if hasName(k, pats, exact) and readAny(v) ~= nil then
                        log(label .. " terdeteksi: attribute " .. k .. " di " .. root.Name, COL.warn)
                        return function() return readAny(root:GetAttribute(k)) end
                    end
                end
            end
            local pg = LocalPlayer:FindFirstChild("PlayerGui")
            if pg then
                for _, d in ipairs(pg:GetDescendants()) do
                    if (d:IsA("TextLabel") or d:IsA("TextButton"))
                    and hasName(d.Name, pats, exact)
                    and not d:IsDescendantOf(gui)
                    and not inBlockedUI(d)
                    and parseNum(d.Text) ~= nil then
                        log(label .. " terdeteksi: UI " .. d:GetFullName(), COL.warn)
                        return function() return parseNum(d.Text) end
                    end
                end
            end
        end
        return nil
    end
    return function()
        if fn then
            local ok, v = pcall(fn)
            if ok and v ~= nil then return v end
            fn = nil
        end
        if tick() - lastSearch > 3 then
            lastSearch = tick()
            local ok, f = pcall(search)
            if ok and f then
                fn = f
                local ok2, v = pcall(fn)
                if ok2 then return v end
            end
        end
        return nil
    end
end

local function makeWaveFinder()
    local fn, lastSearch = nil, 0
    local WN = {"wave", "currentwave"}
    local function search()
        for _, root in ipairs({LocalPlayer, ReplicatedStorage}) do
            for _, d in ipairs(root:GetDescendants()) do
                if d:IsA("ValueBase") and hasName(d.Name, WN, true) and readAny(d) ~= nil then
                    log("Wave terdeteksi: " .. d:GetFullName(), COL.warn)
                    return function() return readAny(d) end
                end
            end
        end
        for _, root in ipairs({LocalPlayer, ReplicatedStorage, workspace}) do
            for k, v in pairs(root:GetAttributes()) do
                if hasName(k, WN, true) and type(v) == "number" then
                    log("Wave terdeteksi: attribute " .. k .. " di " .. root.Name, COL.warn)
                    return function() return readAny(root:GetAttribute(k)) end
                end
            end
        end
        local pg = LocalPlayer:FindFirstChild("PlayerGui")
        if pg then
            for pass = 1, 2 do
                for _, d in ipairs(pg:GetDescendants()) do
                    if (d:IsA("TextLabel") or d:IsA("TextButton"))
                    and not d:IsDescendantOf(gui)
                    and not inBlockedUI(d)
                    and isVisible(d)
                    and waveFromText(d.Text, pass == 1) ~= nil then
                        log("Wave terdeteksi: UI " .. d:GetFullName(), COL.warn)
                        return function()
                            if not d.Parent or not isVisible(d) then return nil end
                            return waveFromText(d.Text, false)
                        end
                    end
                end
            end
        end
        return nil
    end
    return function()
        if fn then
            local ok, v = pcall(fn)
            if ok and v ~= nil then return v end
            fn = nil
        end
        if tick() - lastSearch > 3 then
            lastSearch = tick()
            local ok, f = pcall(search)
            if ok and f then
                fn = f
                local ok2, v = pcall(fn)
                if ok2 then return v end
            end
        end
        return nil
    end
end

