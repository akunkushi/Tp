local FAIL_WORDS = {"not enough", "insufficient", "fail", "cannot", "can't", "invalid", "error", "limit", "max", "too "}
local function isSuccess(res, kind)
    local custom
    if kind == "upgrade" then custom = CONFIG.IsSuccessUpgrade
    elseif kind == "sell" then custom = CONFIG.IsSuccessSell
    else custom = CONFIG.IsSuccess end
    if custom then
        local ok, v = pcall(custom, res)
        return ok and v and true or false
    end
    if res == nil then
        return (kind == "upgrade" or kind == "sell") and CONFIG.NilIsSuccess and true or false
    end
    if res == false then return false end
    if type(res) == "table" then
        if res.success == false or res.Success == false or res.ok == false then return false end
    end
    if type(res) == "string" then
        local l = string.lower(res)
        for _, w in ipairs(FAIL_WORDS) do
            if string.find(l, w, 1, true) then return false end
        end
    end
    return true
end

-- Cari instance tower di workspace.Towers (milik sendiri diprioritaskan)
local function findTowerNear(name, pos)
    local root = workspace:FindFirstChild("Towers") or workspace
    local lname = string.lower(name)
    local myPrefix = string.lower(LocalPlayer.Name) .. "_"
    local best, bestD, bestOwn
    for pass = 1, 2 do -- pass 1: nama cocok, pass 2: hanya posisi
        for _, inst in ipairs(root:GetChildren()) do
            if (inst:IsA("Model") or inst:IsA("BasePart")) and not claimed[inst] then
                local iname = string.lower(inst.Name)
                if pass == 2 or string.find(iname, lname, 1, true) then
                    local ok, cf = pcall(function() return inst:GetPivot() end)
                    if ok then
                        local p = cf.Position
                        local d = Vector2.new(p.X - pos.X, p.Z - pos.Z).Magnitude
                        local own = string.sub(iname, 1, #myPrefix) == myPrefix
                        if d < 4 then
                            if not best or (own and not bestOwn) or (own == bestOwn and d < bestD) then
                                best, bestD, bestOwn = inst, d, own
                            end
                        end
                    end
                end
            end
        end
        if best then break end
    end
    if best then claimed[best] = true end
    return best
end

local function bindTower(id, name, pos)
    task.spawn(function()
        for _ = 1, 30 do
            if not alive then return end
            local inst = findTowerNear(name, pos)
            if inst then
                towerInstances[id] = inst
                instToId[inst] = id
                return
            end
            task.wait(0.1)
        end
        log("Instance tower #" .. tostring(id) .. " tidak ketemu (dicari lewat posisi).", COL.warn)
    end)
end

-- Instance tower -> id rekaman (saat record)
local function idFromInstance(inst)
    if typeof(inst) ~= "Instance" then return nil end
    if instToId[inst] then return instToId[inst] end
    local ok, cf = pcall(function() return inst:GetPivot() end)
    if not ok then return nil end
    local p = cf.Position
    local nm = string.lower(inst.Name)
    local best, bd
    for id, i in pairs(active) do
        if string.find(nm, string.lower(i.name), 1, true) then
            local d = Vector2.new(p.X - i.pos.X, p.Z - i.pos.Z).Magnitude
            if d < 4 and (not bd or d < bd) then best, bd = id, d end
        end
    end
    return best
end

