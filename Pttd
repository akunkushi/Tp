-- Event dari server -> klien. Dicatat saat fase akhir match, atau jika namanya
-- berbau afk/teleport/lobby/kick/zone.
local lastEvLog = {}
local function evSummary(...)
    local t = table.pack(...)
    local out = {}
    for i = 1, math.min(t.n, 3) do
        local s = tostring(t[i])
        if #s > 30 then s = s:sub(1, 30) .. ".." end
        out[#out + 1] = s
    end
    return table.concat(out, ", ")
end

local function watchServerEvents()
    local n = 0
    for _, d in ipairs(ReplicatedStorage:GetDescendants()) do
        if d:IsA("RemoteEvent") and n < 150 then
            n = n + 1
            local name = d.Name
            local lname = string.lower(name)
            local key = string.find(lname, "afk", 1, true) or string.find(lname, "tele", 1, true)
                or string.find(lname, "lobby", 1, true) or string.find(lname, "kick", 1, true)
                or string.find(lname, "zone", 1, true)
            track(d.OnClientEvent:Connect(function(...)
                if not (matchOver or key) then return end
                local now = tick()
                if lastEvLog[name] and now - lastEvLog[name] < 3 then return end
                lastEvLog[name] = now
                log("Server event: " .. name .. " (" .. evSummary(...) .. ")", key and COL.bad or COL.warn)
            end))
        end
    end
    log("Memantau " .. n .. " RemoteEvent dari server (diagnosis).")
end

